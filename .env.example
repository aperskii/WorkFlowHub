APP_NAME=WorkFlowHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Local development convenience: newly registered users are marked as already
# verified so you can reach the dashboard without opening Mailpit. Email
# verification itself stays fully enabled. Keep this false outside local.
AUTH_AUTO_VERIFY_NEW_USERS=true

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL runs in Docker Compose: `docker compose up -d`
# These values configure both the container and the Laravel connection.
# DB_PORT is the published host port; change it if it collides locally.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=workflowhub
DB_USERNAME=workflowhub
DB_PASSWORD=change_me
# Dedicated database used by the automated test suite (see phpunit.xml).
DB_TEST_DATABASE=workflowhub_testing

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail is captured locally by the Mailpit container: `docker compose up -d`.
# MAIL_PORT is Mailpit's SMTP port; MAILPIT_UI_PORT serves the web mailbox at
# http://localhost:8025. Nothing is delivered to real inboxes in development.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAILPIT_UI_PORT=8025

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
