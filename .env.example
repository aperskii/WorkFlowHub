# This file documents local development defaults. Comments marked "Production:"
# call out every value that must differ once the application is deployed; those
# are supplied to the container as environment variables, never from a file in
# version control.

APP_NAME=WorkFlowHub

# Production: `production`. Enables the framework's production behaviour and is
# what `artisan` checks before allowing destructive commands to run unprompted.
APP_ENV=local

# Production: a real key, injected from the deployment's secret store. Never
# committed and never shared between environments, because it decrypts every
# session and cookie. The container refuses to start when this is empty.
APP_KEY=

# Production: `false`, without exception. Debug mode renders stack traces that
# include environment variables and database credentials to anyone who triggers
# an error.
APP_DEBUG=true

# Production: the public HTTPS origin, e.g. https://app.example.com. Used to
# build absolute URLs in mail and signed links, which are wrong or unverifiable
# if this does not match the address users actually reach.
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Local development convenience: newly registered users are marked as already
# verified so you can reach the dashboard without opening Mailpit. Email
# verification itself stays fully enabled.
#
# Production: `false`, without exception. Leaving this on would let anyone
# register with an address they do not control and reach the application as a
# verified user, which also defeats the invitation flow's requirement that the
# invited address be proven before an invitation can be accepted.
AUTH_AUTO_VERIFY_NEW_USERS=true

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL runs in Docker Compose: `docker compose up -d`
# These values configure both the container and the Laravel connection.
# DB_PORT is the published host port; change it if it collides locally.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=workflowhub
DB_USERNAME=workflowhub
DB_PASSWORD=change_me
# Dedicated database used by the automated test suite (see phpunit.xml).
DB_TEST_DATABASE=workflowhub_testing

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Production: `true`. config/session.php reads this with no fallback, so leaving
# it unset means the session cookie is sent without the Secure attribute and
# will travel over plain HTTP. Only set it locally if you serve the application
# over HTTPS, otherwise the cookie is dropped and you cannot log in.
#
# This depends on the trusted-proxy configuration in bootstrap/app.php: behind
# the load balancer the request arrives as HTTP, and Laravel only knows the
# original scheme was HTTPS by reading X-Forwarded-Proto.
# SESSION_SECURE_COOKIE=true

# Defaults in config/session.php are already correct for production and need no
# override: same_site is `lax` and http_only is `true`.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail is captured locally by the Mailpit container: `docker compose up -d`.
# MAIL_PORT is Mailpit's SMTP port; MAILPIT_UI_PORT serves the web mailbox at
# http://localhost:8025. Nothing is delivered to real inboxes in development.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAILPIT_UI_PORT=8025

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
